# Reduced from the original package BUILD.bazel: only targets whose modules run on the phone are kept.
load("//build/kernel/kleaf:kernel.bzl", "ddk_config", "ddk_headers", "ddk_module")
package(default_visibility = ["//visibility:public"])

ddk_config(name="config", kernel_build="//common:kernel_aarch64", kconfigs=["Kconfig"], defconfig="defconfig")
ddk_headers(name="headers", hdrs=glob(["include/**/*.h"], allow_empty = True), linux_includes=["include"])
ddk_module(name="cmd_db", out="cmd-db.ko", kernel_build="//common:kernel_aarch64", config=":config", srcs=["cmd-db.c"], hdrs=[":headers"], includes=["."])
ddk_module(name="rpmh", out="qcom_rpmh.ko", kernel_build="//common:kernel_aarch64", config=":config", srcs=["rpmh.c","rpmh-rsc.c","rpmh-internal.h","rpmh-validate.h","trace-rpmh.h"], hdrs=[":headers"], includes=["."], deps=[":cmd_db"])
