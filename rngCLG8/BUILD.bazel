# CLG8: Qualcomm PRNG (qcom,msm-rng) hwrng driver from the Nothing 5.10 tree, ported to 6.18.
package(default_visibility=['//visibility:public'])
load('//build/kernel/kleaf:kernel.bzl', 'ddk_headers', 'ddk_module')
ddk_headers(name='headers', hdrs=glob(['include/**/*.h']), linux_includes=['include'])
ddk_module(name='msm_rng', kernel_build='//common:kernel_aarch64', out='msm_rng.ko', srcs=['msm_rng.c'], hdrs=[':headers'], copts=['-ferror-limit=0'])
