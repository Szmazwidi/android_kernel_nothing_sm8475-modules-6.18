# pong615 — kontrolna kompilacja portu BT audio (slimbus + NGD + BAM + btfm)
ccflags-y += -DCONFIG_BTFM_SLIM=1
ccflags-y += -I$(src)/include -I$(src)/slimbus -I$(src)/bam -I$(src)/btfm
obj-m += slimbus.o
slimbus-y := slimbus/core.o slimbus/messaging.o slimbus/sched.o slimbus/stream.o
