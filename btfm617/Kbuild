obj-m += slim-qcom-ngd-ctrl.o
slim-qcom-ngd-ctrl-y := slimbus/qcom-ngd-ctrl.o
obj-m += bam_dma.o
bam_dma-y := bam/bam_dma.o
obj-m += bt_fm_slim.o
bt_fm_slim-y := btfm/btfm_slim.o btfm/btfm_slim_slave.o btfm/btfm_slim_codec.o
