# Reduced from the original package BUILD.bazel: only targets whose modules run on the phone are kept.
load("//build/kernel/kleaf:kernel.bzl", "ddk_headers", "ddk_module")
package(default_visibility = ["//visibility:public"])

ddk_headers(name = "local_headers", hdrs = glob(["include/**/*.h"], allow_empty = True), includes = ["include"])
ddk_module(
    name = "slimbus615", out = "slimbus.ko", kernel_build = "//common:kernel_aarch64",
    srcs = ["slimbus/core.c", "slimbus/messaging.c", "slimbus/sched.c", "slimbus/stream.c", "slimbus/slimbus.h"],
    deps = [":local_headers"],
)
ddk_module(name='ngd615', out='slim-qcom-ngd-ctrl.ko', kernel_build='//common:kernel_aarch64', srcs=['slimbus/qcom-ngd-ctrl.c', 'slimbus/slimbus.h', 'slimbus/trace.h'], includes=['slimbus'], copts=['-DCONFIG_QCOM_RPROC_COMMON_MODULE=1'], deps=[':local_headers', ':slimbus615', '//devices/pong618/build:prov_subsystems407_remote407'])
ddk_module(
    name = "bam615", out = "bam_dma.ko", kernel_build = "//common:kernel_aarch64",
    srcs = ["bam/bam_dma.c", "bam/bam_dma_trace.h", "bam/dmaengine.h", "bam/virt-dma.h"],
    includes = ["bam"],
    deps = [":local_headers"],
)
ddk_module(name='btfm615', out='bt_fm_slim.ko', kernel_build='//common:kernel_aarch64', srcs=['btfm/btfm_slim.c', 'btfm/btfm_slim.h', 'btfm/btfm_slim_slave.c', 'btfm/btfm_slim_slave.h', 'btfm/btfm_slim_codec.c'], copts=['-DCONFIG_BTFM_SLIM=1'], deps=[':local_headers', ':slimbus615', '//devices/pong618/build:prov_bt541_bt541'])
