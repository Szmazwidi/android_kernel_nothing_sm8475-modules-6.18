# Reduced from the original package BUILD.bazel: only targets whose modules run on the phone are kept.
load("//build/kernel/kleaf:kernel.bzl", "ddk_config", "ddk_headers", "ddk_module")
package(default_visibility = ["//visibility:public"])

ddk_config(name="config",kernel_build="//common:kernel_aarch64",kconfigs=["Kconfig"],defconfig="defconfig")
ddk_headers(name="headers",hdrs=glob(["include/**/*.h"], allow_empty = True),linux_includes=["include"])
ddk_module(name="vadc",out="qcom-vadc-common.ko",kernel_build="//common:kernel_aarch64",config=":config",srcs=["drivers/iio/adc/qcom-vadc-common.c"],hdrs=[":headers"])
ddk_module(name="adc5",out="qcom-spmi-adc5.ko",kernel_build="//common:kernel_aarch64",config=":config",srcs=["drivers/iio/adc/qcom-spmi-adc5.c"],hdrs=[":headers"],deps=[":vadc"])
